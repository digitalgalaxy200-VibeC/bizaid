# WΛIDE° — Environment Variables Template
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any real secrets.

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Turso control database ---
TURSO_CONTROL_DB_URL=libsql://your-control-db.turso.io
TURSO_CONTROL_DB_AUTH_TOKEN=

# --- Turso platform API (tenant provisioning) ---
# Required for signup: each new business gets its own Turso database.
TURSO_ORG_NAME=
TURSO_API_TOKEN=
# Group where tenant databases are created (defaults to "default").
TURSO_DB_GROUP=default

# --- AI providers ---
# At least one real key is required for chat. Priority: OpenAI → DeepSeek → Anthropic.
# Placeholder/dummy values are ignored by the provider layer.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional override (defaults to https://api.deepseek.com/v1)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
# Unused by the provider layer (no Google provider wired up yet).
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Email (Resend) ---
# Not used in code yet — safe to leave empty.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Cloudflare R2 object storage ---
# Not used in code yet — safe to leave empty.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
